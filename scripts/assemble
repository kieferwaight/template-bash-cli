#!/usr/bin/env bash
set -euo pipefail

source_root=${1:?source directory required}
output=${2:?output file required}
mkdir -p "$(dirname -- "$output")"

declare -A seen=()
stack=()

fail() {
  printf 'assemble: %s\n' "$*" >&2
  exit 1
}

resolve() {
  local relative=$1 path="$source_root/$1"
  [[ $relative != /* ]] || fail "absolute include is forbidden: $relative"
  [[ -f $path ]] || fail "missing source module: $relative"
  [[ -z ${seen[$relative]+x} ]] || return 0
  for item in "${stack[@]}"; do [[ $item != "$relative" ]] || fail "circular include: $relative"; done
  stack+=("$relative")
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line =~ ^[[:space:]]*#%include[[:space:]]+([^[:space:]]+)[[:space:]]*$ ]]; then
      resolve "${BASH_REMATCH[1]}"
    elif [[ $line =~ ^[[:space:]]*#!/ ]]; then
      : # The compiled artifact receives one shebang from argc.
    elif [[ $line =~ ^[[:space:]]*#[[:space:]]@(module|brief|requires|public)([[:space:]]|$) ]]; then
      : # Repository metadata is consumed by validation, not argc.
    else
      printf '%s\n' "$line" >>"$output"
    fi
  done <"$path"
  unset 'stack[${#stack[@]}-1]'
  seen[$relative]=1
}

: >"$output"
printf '#!/usr/bin/env bash\n' >>"$output"
resolve cli.sh
